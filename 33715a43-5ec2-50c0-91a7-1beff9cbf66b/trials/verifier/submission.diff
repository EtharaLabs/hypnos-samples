+fn js_decimal(value: f64) -> String {
+    if value == 0.0 {
+        return String::from("0");
+    }
+    let decimal = value.to_string();
+    if (1e-6..1e21).contains(&value.abs()) {
+        return decimal;
+    }
+    let (sign, unsigned) = if let Some(unsigned) = decimal.strip_prefix('-') {
+        ("-", unsigned)
+    } else {
+        ("", decimal.as_str())
+    };
+    let point = unsigned.find('.').unwrap_or(unsigned.len());
+    let digits = unsigned.replace('.', "");
+    let first = digits.find(|c| c != '0').unwrap_or(0);
+    let digits = digits[first..].trim_end_matches('0');
+    let exponent = point as i32 - first as i32 - 1;
+    let mut result = format!("{sign}{}", &digits[..1]);
+    if digits.len() > 1 {
+        result.push('.');
+        result.push_str(&digits[1..]);
+    }
+    result.push('e');
+    if exponent >= 0 {
+        result.push('+');
+    }
+    result.push_str(&exponent.to_string());
+    result
+}
