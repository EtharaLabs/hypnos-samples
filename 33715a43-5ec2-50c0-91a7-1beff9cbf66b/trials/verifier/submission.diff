+        "hexadecimalKeys",
+        "binaryKeys",
+        "indexKeys",
+        "computed",
+        "spread",
+        "pick",
+        "badKey",
+    ] {
+        assert_eq!(db.ty(module, name), TypeData::Unknown, "{name}");
+    }
+}
