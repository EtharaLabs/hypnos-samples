+            let mut types = Vec::new();
+            for element in elements {
+                types.push(element.ty);
+                if element.is_optional {
+                    types.push(TypeData::Undefined);
+                }
+            }
+            types
+        }
+        TypeData::InstanceOf(instance) if instance.ty(db).is_array_class(db) => {
+            match instance.type_parameters(db).as_ref() {
+                [element] => vec![*element],
+                _ => return TypeData::Unknown,
+            }
+        }
+        _ => return TypeData::Unknown,
+    };
+    if types
+        .iter()
+        .any(|ty| projection_contains_unresolved(db, *ty))
+    {
+        return TypeData::Unknown;
+    }
+    bounded_projection_union(db, types)
+}
+
+fn projection_contains_unresolved<'db>(db: &'db dyn TypeDb, ty: TypeData<'db>) -> bool {
+    let mut pending = vec![ty];
+    let mut seen = FxHashSet::default();
+    for _ in 0..16384 {
+        let Some(ty) = pending.pop() else {
+            return false;
+        };
+        if !seen.insert(ty) {
+            continue;
+        }
+        if matches!(
+            ty,
+            TypeData::Local(_) | TypeData::IndexedAccess(_) | TypeData::TypeOperator(_)
+        ) {
+            return true;
+        }
+        pending.extend(ty.type_slots(db).iter());
+    }
+    true
+}
+
+fn bounded_projection_union<'db>(db: &'db dyn TypeDb, types: Vec<TypeData<'db>>) -> TypeData<'db> {
+    let mut pending = types.into_iter().rev().collect::<Vec<_>>();
+    let mut variants = Vec::new();
+    let mut steps = 0;
+    while let Some(ty) = pending.pop() {
+        steps += 1;
+        if steps > 16384 {
+            return TypeData::Unknown;
+        }
+        match ty {
+            TypeData::Union(union) => pending.extend(union.types(db).iter().rev().copied()),
+            TypeData::Local(_)
+            | TypeData::IndexedAccess(_)
+            | TypeData::TypeOperator(_)
+            | TypeData::Unknown
+            | TypeData::UnknownKeyword
+            | TypeData::AnyKeyword => return TypeData::Unknown,
+            _ => {
+                if !variants.contains(&ty) {
+                    variants.push(ty);
+                }
+                if variants.len() > 1024 {
+                    return TypeData::Unknown;
+                }
+            }
+        }
+    }
+    TypeData::union_from_types(db, variants)
+}
+
+fn project_keys<'db>(db: &'db dyn TypeDb, object: TypeData<'db>) -> TypeData<'db> {
+    use crate::interned_types::{InternedLiteral, Literal};
+    let TypeData::Object(object) = object else {
+        return TypeData::Unknown;
+    };
+    if object.prototype(db).is_some()
+        || object.has_unknown_members(db)
+        || object.has_unknown_keys(db)
+    {
+        return TypeData::Unknown;
+    }
+    let mut keys = Vec::new();
+    for member in object.members(db) {
+        let Some(name) = member.kind.own_string_key_name(db) else {
+            return TypeData::Unknown;
+        };
+        if member.kind.computed_name().is_some()
+            || biome_js_syntax::numbers::parse_js_number(name.text()).is_some_and(f64::is_finite)
+        {
+            return TypeData::Unknown;
+        }
+        let key = TypeData::Literal(InternedLiteral::new(
+            db,
+            Literal::String(name.clone().into()),
+        ));
+        if !keys.contains(&key) {
+            keys.push(key);
+        }
+        if keys.len() > 1024 {
+            return TypeData::Unknown;
+        }
+    }
+    TypeData::union_from_types(db, keys)
+}
