+    who() { return this === undefined ? "undefined" : typeof this; }
+}
+class Derived extends Base {
+    static detached() { return (0, super.who)(); }
+    get detached() { return (0, super.who)(); }
+    set detachedInto(target) { target.value = (0, super.who)(); }
+    arrow() { return (() => (0, super.who)())(); }
+    async later() { return (0, super.who)(); }
+}
