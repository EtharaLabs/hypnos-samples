+//! Hidden behavioural cases for programs the minifier must not change.
+//!
+//! Every case is a JavaScript program with its compressor options (`config.json`, the options the
+//! repository's own fixtures use) and optionally mangler options (`mangle.json`). The program is
+//! minified as the repository's fixture tests minify it (paren removal, resolver, `optimize`,
+//! hygiene unless mangled, fixer), the output must parse, and it is run with node. The output is
+//! then minified and run a second time. The test prints, as its last output line, what both runs
+//! printed and how node exited; the verifier compares that record, outside this process, with
+//! what the original program does under node, which this tree does not hold. The emitted text
+//! itself is never compared.
+//!
+//! Every test body runs on its own thread under a time limit, and node under its own, so a
+//! minifier or a program that hangs fails that test instead of the run.
+
+extern crate swc_malloc;
+
+use std::{
+    io::Read,
+    panic::{catch_unwind, AssertUnwindSafe},
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        mpsc,
+    },
+    time::{Duration, Instant},
+};
+
+use serde::Deserialize;
+use swc_common::{
+    comments::SingleThreadedComments,
+    errors::{Handler, HANDLER},
+    sync::Lrc,
+    FileName, Mark, SourceMap, GLOBALS,
+};
+use swc_ecma_ast::{EsVersion, Program};
+use swc_ecma_codegen::{text_writer::JsWriter, Emitter};
+use swc_ecma_minifier::{
+    optimize,
+    option::{
+        terser::TerserCompressorOptions, ExtraOptions, MangleOptions, MinifyOptions,
+        TopLevelOptions,
+    },
+};
+use swc_ecma_parser::{parse_file_as_module, parse_file_as_script, EsSyntax, Syntax};
+use swc_ecma_transforms_base::{
+    fixer::{fixer, paren_remover},
+    hygiene::hygiene,
+    resolver,
+};
+use swc_ecma_visit::VisitMutWith;
+
+const LIMIT: Duration = Duration::from_secs(120);
+const NODE_LIMIT: Duration = Duration::from_secs(60);
+const ROUNDS: usize = 2;
+
+#[derive(Debug, Default, Clone, Deserialize)]
+struct CaseOptions {
+    #[serde(default)]
+    defaults: bool,
+    #[serde(default)]
+    passes: usize,
+    #[serde(default)]
+    module: bool,
+}
+
+#[derive(Debug, Default, Clone, Deserialize)]
+struct TopLevelOnly {
+    #[serde(default, alias = "toplevel")]
+    top_level: bool,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+#[serde(untagged)]
+enum CaseMangle {
+    Bool(bool),
+    Normal(MangleOptions),
+}
+
+fn mangle_options(s: &str) -> Option<MangleOptions> {
+    let top_level = serde_json::from_str::<TopLevelOnly>(s).unwrap_or_default();
+    match serde_json::from_str::<CaseMangle>(s).expect("mangle.json") {
+        CaseMangle::Bool(false) => None,
+        CaseMangle::Bool(true) => Some(MangleOptions {
+            top_level: Some(false),
+            ..Default::default()
+        }),
+        CaseMangle::Normal(mut v) => {
+            v.top_level = Some(top_level.top_level);
+            Some(v)
+        }
+    }
+}
+
+fn within<F: FnOnce() + Send + 'static>(body: F) {
+    let (tx, rx) = mpsc::channel();
+    std::thread::Builder::new()
+        .stack_size(64 << 20)
+        .spawn(move || {
+            let outcome = catch_unwind(AssertUnwindSafe(body));
+            let _ = tx.send(outcome.is_ok());
+        })
+        .expect("spawn test thread");
+    match rx.recv_timeout(LIMIT) {
+        Ok(true) => {}
+        Ok(false) => panic!("the test body failed"),
+        Err(_) => panic!("the test body did not finish within {LIMIT:?}"),
+    }
+}
+
+#[testing::fixture("tests/runtime-behaviour/**/input.js")]
+fn runtime_behaviour(input: PathBuf) {
+    within(move || {
+        let dir = input.parent().unwrap().to_path_buf();
+        let config = std::fs::read_to_string(dir.join("config.json")).expect("config.json");
+        let mangle = std::fs::read_to_string(dir.join("mangle.json"))
+            .ok()
+            .and_then(|s| mangle_options(&s));
+        let options: CaseOptions = serde_json::from_str(&config).expect("case options");
+        let mut source = std::fs::read_to_string(&input).expect("input.js");
+        let mut stdout = Vec::new();
+        let mut status = Vec::new();
+        for round in 1..=ROUNDS {
+            source = minify(&source, &config, &options, mangle.clone(), round);
+            println!(">>>>> round {round} <<<<<\n{source}");
+            let (out, code) = run_node(&source, options.module);
+            stdout.push(serde_json::Value::String(out));
+            status.push(serde_json::Value::from(code));
+        }
+        let record = serde_json::json!({ "stdout": stdout, "status": status });
+        println!("RUNTIME-BEHAVIOUR-OBSERVED {record}");
+    });
+}
+
+fn minify(
+    source: &str,
+    config: &str,
+    options: &CaseOptions,
+    mangle: Option<MangleOptions>,
+    round: usize,
+) -> String {
+    let disable_hygiene = mangle.is_some();
+    let cm: Lrc<SourceMap> = Default::default();
+    let handler = Handler::with_emitter_writer(Box::new(std::io::stderr()), Some(cm.clone()));
+    let code = GLOBALS.set(&Default::default(), || {
+        HANDLER.set(&handler, || {
+            let fm = cm.new_source_file(
+                FileName::Custom(format!("round-{round}.js")).into(),
+                source.to_string(),
+            );
+            let comments = SingleThreadedComments::default();
+            let mut errors = Vec::new();
+            let syntax = Syntax::Es(EsSyntax::default());
+            let program = if options.module {
+                parse_file_as_module(&fm, syntax, EsVersion::latest(), Some(&comments), &mut errors)
+                    .map(Program::Module)
+            } else {
+                parse_file_as_script(&fm, syntax, EsVersion::latest(), Some(&comments), &mut errors)
+                    .map(Program::Script)
+            };
+            let mut program = program.expect("the program parses");
+            assert!(errors.is_empty(), "the program parses without errors: {errors:?}");
+
+            let unresolved_mark = Mark::new();
+            let top_level_mark = Mark::new();
+            program.visit_mut_with(&mut paren_remover(Some(&comments)));
+            program.visit_mut_with(&mut resolver(unresolved_mark, top_level_mark, false));
+
+            let mut c: TerserCompressorOptions =
+                serde_json::from_str(config).expect("compressor options");
+            c.defaults = options.defaults;
+            c.pristine_globals = Some(true);
+            c.passes = options.passes;
+            c.module = options.module;
+            let mut compress = c.into_config(cm.clone());
+            if compress.top_level.is_none() {
+                compress.top_level = Some(TopLevelOptions {
+                    functions: options.module,
+                });
+            }
+
+            let mut output = optimize(
+                program,
+                cm.clone(),
+                Some(&comments),
+                None,
+                &MinifyOptions {
+                    compress: Some(compress),
+                    mangle,
+                    ..Default::default()
+                },
+                &ExtraOptions {
+                    unresolved_mark,
+                    top_level_mark,
+                    mangle_name_cache: None,
+                },
+            );
+            if !disable_hygiene {
+                output.visit_mut_with(&mut hygiene());
+            }
+            let output = output.apply(&mut fixer(None));
+
+            let mut buf = Vec::new();
+            {
+                let mut emitter = Emitter {
+                    cfg: Default::default(),
+                    cm: cm.clone(),
+                    comments: Some(&comments),
+                    wr: JsWriter::new(cm.clone(), "\n", &mut buf, None),
+                };
+                emitter.emit_program(&output).expect("codegen");
+            }
+            let code = String::from_utf8(buf).expect("utf8 output");
+            reparse(&code, options.module);
+            code
+        })
+    });
+    assert!(!handler.has_errors(), "the minifier must not report an error");
+    code
+}
+
+fn reparse(code: &str, module: bool) {
+    let cm: Lrc<SourceMap> = Default::default();
+    let fm = cm.new_source_file(FileName::Custom("emitted.js".into()).into(), code.to_string());
+    let mut errors = Vec::new();
+    let syntax = Syntax::Es(EsSyntax::default());
+    let ok = if module {
+        parse_file_as_module(&fm, syntax, EsVersion::latest(), None, &mut errors).is_ok()
+    } else {
+        parse_file_as_script(&fm, syntax, EsVersion::latest(), None, &mut errors).is_ok()
+    };
+    assert!(
+        ok && errors.is_empty(),
+        "the minified code must parse: {errors:?}"
+    );
+}
+
+fn run_node(code: &str, module: bool) -> (String, i32) {
+    static COUNTER: AtomicUsize = AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!(
+        "runtime-behaviour-{}-{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let file = dir.join(if module { "case.mjs" } else { "case.cjs" });
+    std::fs::write(&file, code).unwrap();
+    let mut child = Command::new("node")
+        .arg(Path::new(&file))
+        .current_dir(&dir)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .spawn()
+        .expect("node runs");
+    let mut stdout = child.stdout.take().unwrap();
+    let reader = std::thread::spawn(move || {
+        let mut out = String::new();
+        let _ = stdout.read_to_string(&mut out);
+        out
+    });
+    let started = Instant::now();
+    let code = loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            break status.code().unwrap_or(-1);
+        }
+        if started.elapsed() > NODE_LIMIT {
+            let _ = child.kill();
+            let _ = child.wait();
+            panic!("the minified program did not finish within {NODE_LIMIT:?}");
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    };
+    let out = reader.join().unwrap();
+    let _ = std::fs::remove_dir_all(&dir);
+    (out, code)
+}
