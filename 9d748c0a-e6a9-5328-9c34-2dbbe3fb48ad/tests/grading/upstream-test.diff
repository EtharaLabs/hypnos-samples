+    spec.setSqlDate(java.sql.Date.valueOf("2024-01-15"));
+    spec.setSqlDates(List.of(java.sql.Date.valueOf("2024-01-15"), java.sql.Date.valueOf("2024-12-31")));
+    spec.setLocale(Locale.forLanguageTag("zh-Hant-TW"));
