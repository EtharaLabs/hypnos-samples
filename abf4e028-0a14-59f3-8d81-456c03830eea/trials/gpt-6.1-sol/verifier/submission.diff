diff -ruN a/crates/swc_ecma_transforms_typescript/src/namespace/declarations.rs b/crates/swc_ecma_transforms_typescript/src/namespace/declarations.rs
--- a/crates/swc_ecma_transforms_typescript/src/namespace/declarations.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/swc_ecma_transforms_typescript/src/namespace/declarations.rs	2026-11-13 16:08:48.880868526 +0000
@@ -0,0 +1,220 @@
+//! Collect identities and value members across all bodies of a namespace.
+use rustc_hash::{FxHashMap, FxHashSet};
+use swc_atoms::Atom;
+use swc_ecma_ast::*;
+use swc_ecma_utils::find_pat_ids;
+use swc_ecma_visit::{noop_visit_type, Visit, VisitWith};
+
+use crate::retain::IsConcrete;
+
+#[derive(Default)]
+pub(super) struct Declarations {
+    pub(super) members: FxHashMap<Id, FxHashSet<Atom>>,
+    pub(super) exports: FxHashMap<(Id, Atom), Id>,
+    pub(super) aliases: FxHashMap<Id, Id>,
+    pub(super) properties: FxHashSet<Id>,
+    namespace: Option<Id>,
+    ambient: bool,
+    pub(super) types: FxHashSet<Id>,
+    pub(super) values: FxHashSet<Id>,
+    pub(super) imports: FxHashMap<Id, TsEntityName>,
+}
+
+impl Declarations {
+    fn export(&mut self, id: Id) {
+        let Some(namespace) = &self.namespace else {
+            return;
+        };
+        self.members
+            .entry(namespace.clone())
+            .or_default()
+            .insert(id.0.clone());
+        self.export_type(id);
+    }
+
+    fn export_type(&mut self, id: Id) {
+        let Some(namespace) = &self.namespace else {
+            return;
+        };
+        let canonical = self
+            .exports
+            .entry((namespace.clone(), id.0.clone()))
+            .or_insert_with(|| id.clone());
+        if &id != canonical {
+            self.aliases.insert(id, canonical.clone());
+        }
+    }
+
+    fn export_decl(&mut self, decl: &Decl) {
+        match decl {
+            Decl::Var(n) => {
+                for id in find_pat_ids::<_, Id>(&n.decls) {
+                    self.properties.insert(id.clone());
+                    self.export(id);
+                }
+            }
+            Decl::Fn(n) => self.export(n.ident.to_id()),
+            Decl::Class(n) => self.export(n.ident.to_id()),
+            Decl::TsEnum(n) => {
+                self.properties.insert(n.id.to_id());
+                self.export(n.id.to_id());
+            }
+            Decl::TsModule(n) => {
+                if let TsModuleName::Ident(id) = &n.id {
+                    if namespace_has_value(n, self.ambient) {
+                        self.properties.insert(id.to_id());
+                        self.export(id.to_id());
+                    } else {
+                        self.export_type(id.to_id());
+                    }
+                }
+            }
+            Decl::TsInterface(n) => self.export_type(n.id.to_id()),
+            Decl::TsTypeAlias(n) => self.export_type(n.id.to_id()),
+            _ => {}
+        }
+    }
+
+    fn body(&mut self, id: Id, body: &TsNamespaceBody) {
+        let id = self.aliases.get(&id).cloned().unwrap_or(id);
+        let old = self.namespace.replace(id);
+        body.visit_with(self);
+        self.namespace = old;
+    }
+}
+
+impl Visit for Declarations {
+    noop_visit_type!();
+
+    fn visit_export_decl(&mut self, n: &ExportDecl) {
+        self.export_decl(&n.decl);
+        n.visit_children_with(self);
+    }
+
+    fn visit_ts_import_equals_decl(&mut self, n: &TsImportEqualsDecl) {
+        if n.is_type_only {
+            self.types.insert(n.id.to_id());
+        } else if let TsModuleRef::TsEntityName(name) = &n.module_ref {
+            self.imports.insert(n.id.to_id(), name.clone());
+        }
+        if n.is_export || self.ambient {
+            if n.is_type_only {
+                self.export_type(n.id.to_id());
+            } else {
+                self.properties.insert(n.id.to_id());
+                self.export(n.id.to_id());
+            }
+        }
+    }
+
+    fn visit_decl(&mut self, n: &Decl) {
+        if self.ambient {
+            self.export_decl(n);
+        }
+        match n {
+            Decl::TsInterface(n) => {
+                self.types.insert(n.id.to_id());
+            }
+            Decl::TsTypeAlias(n) => {
+                self.types.insert(n.id.to_id());
+            }
+            Decl::Fn(n) => {
+                self.values.insert(n.ident.to_id());
+            }
+            Decl::Class(n) => {
+                self.values.insert(n.ident.to_id());
+            }
+            Decl::Var(n) => {
+                self.values.extend(find_pat_ids::<_, Id>(&n.decls));
+            }
+            _ => {}
+        }
+        n.visit_children_with(self);
+    }
+
+    fn visit_ts_module_decl(&mut self, n: &TsModuleDecl) {
+        if let (TsModuleName::Ident(id), Some(body)) = (&n.id, &n.body) {
+            if namespace_has_value(n, self.ambient) {
+                self.values.insert(id.to_id());
+            } else {
+                self.types.insert(id.to_id());
+            }
+            let old = self.ambient;
+            self.ambient |= n.declare;
+            self.body(id.to_id(), body);
+            self.ambient = old;
+        }
+    }
+
+    fn visit_ts_namespace_decl(&mut self, n: &TsNamespaceDecl) {
+        if if n.declare || self.ambient {
+            ambient_body_has_value(&n.body)
+        } else {
+            n.body.is_concrete()
+        } {
+            self.values.insert(n.id.to_id());
+            self.export(n.id.to_id());
+        } else {
+            self.types.insert(n.id.to_id());
+            self.export_type(n.id.to_id());
+        }
+        let old = self.ambient;
+        self.ambient |= n.declare;
+        self.body(n.id.to_id(), &n.body);
+        self.ambient = old;
+    }
+
+    fn visit_ts_enum_decl(&mut self, n: &TsEnumDecl) {
+        self.values.insert(n.id.to_id());
+        let id = self
+            .aliases
+            .get(&n.id.to_id())
+            .cloned()
+            .unwrap_or_else(|| n.id.to_id());
+        let members = self.members.entry(id).or_default();
+        for member in &n.members {
+            match &member.id {
+                TsEnumMemberId::Ident(id) => {
+                    members.insert(id.sym.clone());
+                }
+                TsEnumMemberId::Str(s) => {
+                    if let Some(name) = s.value.as_atom() {
+                        members.insert(name.clone());
+                    }
+                }
+                #[cfg(swc_ast_unknown)]
+                _ => {}
+            }
+        }
+        n.members.visit_with(self);
+    }
+}
+
+/// Ambient functions and variables are values even though they emit no code.
+/// A namespace containing only interfaces or type aliases has no value space.
+fn namespace_has_value(n: &TsModuleDecl, ambient: bool) -> bool {
+    if n.declare || ambient {
+        n.body.as_ref().is_some_and(ambient_body_has_value)
+    } else {
+        n.is_concrete()
+    }
+}
+
+fn ambient_body_has_value(body: &TsNamespaceBody) -> bool {
+    match body {
+        TsNamespaceBody::TsNamespaceDecl(n) => ambient_body_has_value(&n.body),
+        TsNamespaceBody::TsModuleBlock(block) => block.body.iter().any(|item| match item {
+            ModuleItem::Stmt(Stmt::Decl(decl))
+            | ModuleItem::ModuleDecl(ModuleDecl::ExportDecl(ExportDecl { decl, .. })) => match decl
+            {
+                Decl::TsInterface(_) | Decl::TsTypeAlias(_) => false,
+                Decl::TsModule(n) => namespace_has_value(n, true),
+                _ => true,
+            },
+            ModuleItem::ModuleDecl(ModuleDecl::TsImportEquals(n)) => !n.is_type_only,
+            _ => false,
+        }),
+        #[cfg(swc_ast_unknown)]
+        _ => false,
+    }
+}
diff -ruN a/crates/swc_ecma_transforms_typescript/src/namespace/locals.rs b/crates/swc_ecma_transforms_typescript/src/namespace/locals.rs
--- a/crates/swc_ecma_transforms_typescript/src/namespace/locals.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/swc_ecma_transforms_typescript/src/namespace/locals.rs	2026-11-13 16:08:48.880868526 +0000
@@ -0,0 +1,103 @@
+use rustc_hash::FxHashSet;
+use swc_ecma_ast::*;
+use swc_ecma_visit::{noop_visit_type, Visit, VisitWith};
+
+/// Resolved ids distinguish a body's bindings (including nested parameters and
+/// block bindings) from outer bindings with the same spelling. Nested namespace
+/// and enum bodies get their own frames, so do not collect their bindings here;
+/// this also keeps collection linear for deeply nested namespaces.
+#[derive(Default)]
+pub(super) struct Locals {
+    pub(super) ids: FxHashSet<Id>,
+    assignment_target: bool,
+}
+impl Visit for Locals {
+    noop_visit_type!();
+
+    fn visit_binding_ident(&mut self, n: &BindingIdent) {
+        if !self.assignment_target {
+            self.ids.insert(n.to_id());
+        }
+    }
+
+    fn visit_assign_expr(&mut self, n: &AssignExpr) {
+        // Assignment patterns reuse BindingIdent nodes, but do not declare
+        // bindings. Their references must participate in merged lookup.
+        let old = std::mem::replace(&mut self.assignment_target, true);
+        n.left.visit_with(self);
+        self.assignment_target = old;
+        n.right.visit_with(self);
+    }
+
+    fn visit_for_head(&mut self, n: &ForHead) {
+        let old = std::mem::replace(&mut self.assignment_target, matches!(n, ForHead::Pat(_)));
+        n.visit_children_with(self);
+        self.assignment_target = old;
+    }
+
+    fn visit_function(&mut self, n: &Function) {
+        let old = std::mem::replace(&mut self.assignment_target, false);
+        n.visit_children_with(self);
+        self.assignment_target = old;
+    }
+
+    fn visit_arrow_expr(&mut self, n: &ArrowExpr) {
+        let old = std::mem::replace(&mut self.assignment_target, false);
+        n.visit_children_with(self);
+        self.assignment_target = old;
+    }
+
+    fn visit_class(&mut self, n: &Class) {
+        let old = std::mem::replace(&mut self.assignment_target, false);
+        n.visit_children_with(self);
+        self.assignment_target = old;
+    }
+
+    fn visit_setter_prop(&mut self, n: &SetterProp) {
+        let old = std::mem::replace(&mut self.assignment_target, false);
+        n.visit_children_with(self);
+        self.assignment_target = old;
+    }
+
+    fn visit_fn_decl(&mut self, n: &FnDecl) {
+        self.ids.insert(n.ident.to_id());
+        n.function.visit_with(self);
+    }
+
+    fn visit_class_decl(&mut self, n: &ClassDecl) {
+        self.ids.insert(n.ident.to_id());
+        n.class.visit_with(self);
+    }
+
+    fn visit_fn_expr(&mut self, n: &FnExpr) {
+        if let Some(id) = &n.ident {
+            self.ids.insert(id.to_id());
+        }
+        n.function.visit_with(self);
+    }
+
+    fn visit_class_expr(&mut self, n: &ClassExpr) {
+        if let Some(id) = &n.ident {
+            self.ids.insert(id.to_id());
+        }
+        n.class.visit_with(self);
+    }
+
+    fn visit_ts_module_decl(&mut self, n: &TsModuleDecl) {
+        if let TsModuleName::Ident(id) = &n.id {
+            self.ids.insert(id.to_id());
+        }
+    }
+
+    fn visit_ts_namespace_decl(&mut self, n: &TsNamespaceDecl) {
+        self.ids.insert(n.id.to_id());
+    }
+
+    fn visit_ts_enum_decl(&mut self, n: &TsEnumDecl) {
+        self.ids.insert(n.id.to_id());
+    }
+
+    fn visit_ts_import_equals_decl(&mut self, n: &TsImportEqualsDecl) {
+        self.ids.insert(n.id.to_id());
+    }
+}
diff -ruN a/crates/swc_ecma_transforms_typescript/src/namespace.rs b/crates/swc_ecma_transforms_typescript/src/namespace.rs
--- a/crates/swc_ecma_transforms_typescript/src/namespace.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/swc_ecma_transforms_typescript/src/namespace.rs	2026-11-13 16:08:48.880403513 +0000
@@ -0,0 +1,287 @@
+//! Reconcile the lexical scopes produced by the resolver with TypeScript's
+//! declaration merging. Private bindings stay local to a body; exported values
+//! are visible from every body, including bodies preceding their declaration.
+use rustc_hash::{FxHashMap, FxHashSet};
+use swc_ecma_ast::*;
+use swc_ecma_utils::{ExprFactory, QueryRef, RefRewriter};
+use swc_ecma_visit::{VisitMut, VisitMutWith, VisitWith};
+
+mod declarations;
+mod locals;
+
+use self::{declarations::Declarations, locals::Locals};
+
+pub(crate) fn reconcile(program: &mut Program) -> crate::value_bindings::ValueBindings {
+    let mut declarations;
+    loop {
+        declarations = Declarations::default();
+        program.visit_with(&mut declarations);
+        if !declarations.aliases.is_empty() {
+            program.visit_mut_with(&mut Canonicalize(&declarations.aliases));
+            // Recollect after canonicalizing nested exported declarations.
+            declarations = Declarations::default();
+            program.visit_with(&mut declarations);
+        }
+        if declarations.imports.is_empty() {
+            break;
+        }
+        let bindings = crate::value_bindings::ValueBindings {
+            exports: declarations.exports.clone(),
+            imports: std::mem::take(&mut declarations.imports),
+        };
+        let type_aliases: FxHashSet<_> = bindings
+            .imports
+            .keys()
+            .filter(|id| {
+                bindings.alias_target(id).is_some_and(|target| {
+                    declarations.types.contains(&target) && !declarations.values.contains(&target)
+                })
+            })
+            .cloned()
+            .collect();
+        if type_aliases.is_empty() {
+            break;
+        }
+        let mut prune = TypeOnlyAliases {
+            ids: &type_aliases,
+            changed: false,
+        };
+        program.visit_mut_with(&mut prune);
+        if !prune.changed {
+            break;
+        }
+        // Removing an alias can make its containing namespace type-only, which
+        // in turn makes aliases to that namespace type-only. Each iteration
+        // marks at least one new alias; cycles therefore cannot stall this
+        // pass.
+    }
+    if declarations.members.is_empty() {
+        return Default::default();
+    }
+    let mut references = References {
+        declarations: &declarations,
+        frames: Vec::new(),
+        imports: Default::default(),
+    };
+    program.visit_mut_with(&mut references);
+    let imports = references.imports;
+    crate::value_bindings::ValueBindings {
+        exports: declarations.exports,
+        imports,
+    }
+}
+
+struct TypeOnlyAliases<'a> {
+    ids: &'a FxHashSet<Id>,
+    changed: bool,
+}
+impl VisitMut for TypeOnlyAliases<'_> {
+    fn visit_mut_ts_type(&mut self, _: &mut TsType) {}
+
+    fn visit_mut_ts_import_equals_decl(&mut self, n: &mut TsImportEqualsDecl) {
+        if !n.is_type_only && self.ids.contains(&n.id.to_id()) {
+            n.is_type_only = true;
+            self.changed = true;
+        }
+    }
+}
+
+struct Canonicalize<'a>(&'a FxHashMap<Id, Id>);
+impl VisitMut for Canonicalize<'_> {
+    fn visit_mut_ident(&mut self, n: &mut Ident) {
+        if let Some(id) = self.0.get(&n.to_id()) {
+            n.ctxt = id.1;
+        }
+    }
+}
+
+struct Frame {
+    id: Id,
+    locals: FxHashSet<Id>,
+}
+struct References<'a> {
+    declarations: &'a Declarations,
+    frames: Vec<Frame>,
+    imports: FxHashMap<Id, TsEntityName>,
+}
+impl QueryRef for References<'_> {
+    fn query_ref(&self, ident: &Ident) -> Option<Box<Expr>> {
+        for frame in self.frames.iter().rev() {
+            if frame.locals.contains(&ident.to_id()) {
+                return None;
+            }
+            if self
+                .declarations
+                .members
+                .get(&frame.id)
+                .is_some_and(|members| members.contains(&ident.sym))
+            {
+                return Some(frame.id.clone().make_member(ident.clone().into()).into());
+            }
+        }
+        None
+    }
+
+    fn query_lhs(&self, ident: &Ident) -> Option<Box<Expr>> {
+        self.query_ref(ident)
+    }
+
+    fn query_jsx(&self, ident: &Ident) -> Option<JSXElementName> {
+        let Expr::Member(member) = *self.query_ref(ident)? else {
+            return None;
+        };
+        let Expr::Ident(obj) = *member.obj else {
+            return None;
+        };
+        Some(
+            JSXMemberExpr {
+                span: ident.span,
+                obj: JSXObject::Ident(obj),
+                prop: ident.clone().into(),
+            }
+            .into(),
+        )
+    }
+}
+impl QueryRef for &References<'_> {
+    fn query_ref(&self, ident: &Ident) -> Option<Box<Expr>> {
+        (**self).query_ref(ident)
+    }
+
+    fn query_lhs(&self, ident: &Ident) -> Option<Box<Expr>> {
+        (**self).query_lhs(ident)
+    }
+
+    fn query_jsx(&self, ident: &Ident) -> Option<JSXElementName> {
+        (**self).query_jsx(ident)
+    }
+}
+impl References<'_> {
+    fn body(&mut self, id: Id, body: &mut TsNamespaceBody) {
+        let mut locals = Locals::default();
+        body.visit_with(&mut locals);
+        self.frames.push(Frame {
+            id,
+            locals: locals.ids,
+        });
+        body.visit_mut_with(self);
+        self.frames.pop();
+    }
+}
+impl VisitMut for References<'_> {
+    fn visit_mut_ts_type(&mut self, _: &mut TsType) {}
+
+    fn visit_mut_ts_import_equals_decl(&mut self, n: &mut TsImportEqualsDecl) {
+        if n.is_type_only {
+            return;
+        }
+        n.module_ref.visit_mut_with(self);
+        if let TsModuleRef::TsEntityName(name) = &n.module_ref {
+            self.imports.insert(n.id.to_id(), name.clone());
+        }
+    }
+
+    fn visit_mut_ts_entity_name(&mut self, n: &mut TsEntityName) {
+        match n {
+            TsEntityName::Ident(ident) => {
+                let replacement = self.query_ref(ident).or_else(|| {
+                    // Exported variables, namespaces, enums and aliases have
+                    // property storage even in their own body. Entity names
+                    // bypass the ordinary expression reference rewriter.
+                    if !self.declarations.properties.contains(&ident.to_id()) {
+                        return None;
+                    }
+                    for frame in self.frames.iter().rev() {
+                        if frame.locals.contains(&ident.to_id()) {
+                            return (self
+                                .declarations
+                                .exports
+                                .get(&(frame.id.clone(), ident.sym.clone()))
+                                == Some(&ident.to_id()))
+                            .then(|| frame.id.clone().make_member(ident.clone().into()).into());
+                        }
+                    }
+                    None
+                });
+                if let Some(expr) = replacement {
+                    match *expr {
+                        Expr::Member(MemberExpr {
+                            obj,
+                            prop: MemberProp::Ident(right),
+                            ..
+                        }) => {
+                            if let Expr::Ident(left) = *obj {
+                                *n = TsEntityName::TsQualifiedName(Box::new(TsQualifiedName {
+                                    span: ident.span,
+                                    left: TsEntityName::Ident(left),
+                                    right,
+                                }));
+                            }
+                        }
+                        Expr::Ident(id) => *ident = id,
+                        _ => unreachable!(),
+                    }
+                }
+            }
+            TsEntityName::TsQualifiedName(name) => name.left.visit_mut_with(self),
+            #[cfg(swc_ast_unknown)]
+            _ => {}
+        }
+    }
+
+    fn visit_mut_ts_module_decl(&mut self, n: &mut TsModuleDecl) {
+        if let (TsModuleName::Ident(id), Some(body)) = (&n.id, &mut n.body) {
+            self.body(id.to_id(), body);
+        }
+    }
+
+    fn visit_mut_ts_namespace_decl(&mut self, n: &mut TsNamespaceDecl) {
+        self.body(n.id.to_id(), &mut n.body);
+    }
+
+    fn visit_mut_ts_enum_decl(&mut self, n: &mut TsEnumDecl) {
+        let mut locals = Locals::default();
+        n.members.visit_with(&mut locals);
+        self.frames.push(Frame {
+            id: n.id.to_id(),
+            locals: locals.ids,
+        });
+        n.members.visit_mut_with(self);
+        self.frames.pop();
+    }
+
+    fn visit_mut_expr(&mut self, n: &mut Expr) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_expr(n);
+    }
+
+    fn visit_mut_prop(&mut self, n: &mut Prop) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_prop(n);
+    }
+
+    fn visit_mut_pat(&mut self, n: &mut Pat) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_pat(n);
+    }
+
+    fn visit_mut_object_pat_prop(&mut self, n: &mut ObjectPatProp) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_object_pat_prop(n);
+    }
+
+    fn visit_mut_simple_assign_target(&mut self, n: &mut SimpleAssignTarget) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_simple_assign_target(n);
+    }
+
+    fn visit_mut_jsx_element_name(&mut self, n: &mut JSXElementName) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_jsx_element_name(n);
+    }
+
+    fn visit_mut_jsx_object(&mut self, n: &mut JSXObject) {
+        n.visit_mut_children_with(self);
+        RefRewriter { query: &*self }.exit_jsx_object(n);
+    }
+}
