diff --git a/crates/swc_ecma_transforms_typescript/tests/runtime_semantics.rs b/crates/swc_ecma_transforms_typescript/tests/runtime_semantics.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e4c162fd79ba119c6cba5837b852e552ccf390b1
--- /dev/null
+++ b/crates/swc_ecma_transforms_typescript/tests/runtime_semantics.rs
@@ -0,0 +1,185 @@
+//! Hidden behavioural grader for merged namespace and enum declarations.
+//!
+//! Every case is a TypeScript program. It is compiled with this crate's TypeScript transform as
+//! the repository's own runtime tests compile it (resolver, typescript, hygiene, fixer), the
+//! emitted JavaScript must parse, and it is then run with node through `observe.mjs`, which
+//! records every value the program hands to `expect(...)`, every `console.log`, an uncaught
+//! error's constructor, and the module's exports. The test prints that record as its last output
+//! line; the verifier compares it, outside this process, with the record the TypeScript
+//! compiler's own emit of the same program produces under the same observer, which this tree
+//! does not hold. The emitted text itself (parameter names, inlining, statement shape) is never
+//! compared.
+//!
+//! Every test body runs on its own thread under a time limit, and node under its own, so a
+//! transform or a program that hangs fails that test instead of the run.
+
+use std::{
+    io::Read,
+    panic::{catch_unwind, AssertUnwindSafe},
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        mpsc,
+    },
+    time::{Duration, Instant},
+};
+
+use swc_common::{comments::SingleThreadedComments, Mark};
+use swc_ecma_ast::{EsVersion, Program};
+use swc_ecma_parser::{parse_file_as_module, EsSyntax, Syntax, TsSyntax};
+use swc_ecma_transforms_base::{fixer::fixer, hygiene::hygiene, resolver};
+use swc_ecma_transforms_proposal::decorators;
+use swc_ecma_transforms_typescript::{typescript, Config};
+
+const LIMIT: Duration = Duration::from_secs(120);
+const NODE_LIMIT: Duration = Duration::from_secs(60);
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct CaseOptions {
+    config: Config,
+    decorators: bool,
+    handle_types: bool,
+}
+
+fn within<F: FnOnce() + Send + 'static>(body: F) {
+    let (tx, rx) = mpsc::channel();
+    std::thread::Builder::new()
+        .stack_size(64 << 20)
+        .spawn(move || {
+            let outcome = catch_unwind(AssertUnwindSafe(body));
+            let _ = tx.send(outcome.is_ok());
+        })
+        .expect("spawn test thread");
+    match rx.recv_timeout(LIMIT) {
+        Ok(true) => {}
+        Ok(false) => panic!("the test body failed"),
+        Err(_) => panic!("the test body did not finish within {LIMIT:?}"),
+    }
+}
+
+#[testing::fixture("tests/runtime-semantics/**/input.ts")]
+fn runtime_semantics(input: PathBuf) {
+    within(move || {
+        let dir = input.parent().unwrap().to_path_buf();
+        let options: CaseOptions =
+            serde_json::from_str(&std::fs::read_to_string(dir.join("options.json")).unwrap())
+                .expect("case options");
+        let code = compile(&input, &options);
+        println!(">>>>> emitted <<<<<\n{code}");
+        reparse(&code);
+        let observed = observe(&code);
+        let observed: serde_json::Value = serde_json::from_str(observed.trim_end())
+            .expect("the observer prints one JSON record");
+        assert!(observed.is_array(), "the observer prints one JSON record");
+        println!("RUNTIME-SEMANTICS-OBSERVED {observed}");
+    });
+}
+
+fn compile(input: &Path, options: &CaseOptions) -> String {
+    testing::run_test(false, |cm, _handler| {
+        let fm = cm.load_file(input).unwrap();
+        let comments = SingleThreadedComments::default();
+        let mut errors = Vec::new();
+        let module = parse_file_as_module(
+            &fm,
+            Syntax::Typescript(TsSyntax {
+                decorators: options.decorators,
+                ..Default::default()
+            }),
+            EsVersion::latest(),
+            Some(&comments),
+            &mut errors,
+        )
+        .expect("the case parses as TypeScript");
+        assert!(errors.is_empty(), "the case parses as TypeScript without errors");
+        let mut program = Program::Module(module);
+        let unresolved = Mark::new();
+        let top_level = Mark::new();
+        program.mutate(resolver(unresolved, top_level, options.handle_types));
+        program.mutate(typescript(options.config, unresolved, top_level));
+        if options.decorators {
+            program.mutate(decorators(decorators::Config {
+                legacy: true,
+                ..Default::default()
+            }));
+        }
+        program.mutate(hygiene());
+        program.mutate(fixer(Some(&comments)));
+        Ok(swc_ecma_codegen::to_code_default(
+            cm.clone(),
+            Some(&comments),
+            &program,
+        ))
+    })
+    .expect("the transform must not report an error")
+}
+
+fn reparse(code: &str) {
+    testing::run_test(false, |cm, _handler| {
+        let fm = cm.new_source_file(
+            swc_common::FileName::Custom("emitted.mjs".into()).into(),
+            code.to_string(),
+        );
+        let mut errors = Vec::new();
+        let parsed = parse_file_as_module(
+            &fm,
+            Syntax::Es(EsSyntax::default()),
+            EsVersion::latest(),
+            None,
+            &mut errors,
+        );
+        assert!(
+            parsed.is_ok() && errors.is_empty(),
+            "the emitted code must parse as a JavaScript module: {:?} {:?}",
+            parsed.err(),
+            errors
+        );
+        Ok(())
+    })
+    .expect("the emitted code must parse as a JavaScript module");
+}
+
+fn observe(code: &str) -> String {
+    static COUNTER: AtomicUsize = AtomicUsize::new(0);
+    let observer = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/runtime-semantics/observe.mjs");
+    let dir = std::env::temp_dir().join(format!(
+        "runtime-semantics-{}-{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let file = dir.join("case.mjs");
+    std::fs::write(&file, code).unwrap();
+    let mut child = Command::new("node")
+        .arg(&observer)
+        .arg(&file)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .spawn()
+        .expect("node runs");
+    let mut stdout = child.stdout.take().unwrap();
+    let reader = std::thread::spawn(move || {
+        let mut out = String::new();
+        let _ = stdout.read_to_string(&mut out);
+        out
+    });
+    let started = Instant::now();
+    loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            assert!(status.success(), "node exited with {status}");
+            break;
+        }
+        if started.elapsed() > NODE_LIMIT {
+            let _ = child.kill();
+            let _ = child.wait();
+            panic!("the emitted program did not finish within {NODE_LIMIT:?}");
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let out = reader.join().unwrap();
+    let _ = std::fs::remove_dir_all(&dir);
+    out
+}
