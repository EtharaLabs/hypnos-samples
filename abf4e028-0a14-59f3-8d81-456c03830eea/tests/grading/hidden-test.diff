new file mode 100644
index 0000000000000000000000000000000000000000..a838bd29437746645a9dce6045c0cc2fe9565537
--- /dev/null
+++ b/crates/swc_ecma_transforms_typescript/tests/runtime-semantics/observe.mjs
@@ -0,0 +1,100 @@
+// Runs one emitted ES module and prints, as JSON, what it observably did: every value handed to
+// expect(...) with the matcher and its arguments, every console.log, whether a function handed to
+// toThrow threw (and the error's constructor), an uncaught error's constructor, and the module's
+// exports. Objects are compared by their own enumerable string keys in sorted order, so a
+// different emission order of equal members does not matter.
+// Usage: node observe.mjs <module.mjs>
+import { pathToFileURL } from "node:url";
+
+const log = [];
+
+function dump(value, seen = new Set(), depth = 0) {
+    switch (typeof value) {
+        case "undefined":
+            return { undefined: true };
+        case "boolean":
+        case "string":
+            return value;
+        case "number":
+            if (Number.isNaN(value)) return { number: "NaN" };
+            if (Object.is(value, -0)) return { number: "-0" };
+            if (!Number.isFinite(value)) return { number: String(value) };
+            return value;
+        case "bigint":
+            return { bigint: String(value) };
+        case "symbol":
+            return { symbol: String(value.description) };
+        case "function":
+            return { function: value.name };
+        default:
+            break;
+    }
+    if (value === null) return null;
+    if (seen.has(value) || depth > 8) return { cycle: true };
+    seen.add(value);
+    try {
+        if (Array.isArray(value)) {
+            return { array: value.map((item) => dump(item, seen, depth + 1)) };
+        }
+        const proto = Object.getPrototypeOf(value);
+        const kind =
+            proto === null ? "null" : proto.constructor ? proto.constructor.name : "anonymous";
+        const keys = Object.keys(value).sort();
+        return {
+            object: kind,
+            props: keys.map((key) => {
+                let item;
+                try {
+                    item = dump(value[key], seen, depth + 1);
+                } catch (error) {
+                    item = { getterThrew: errorName(error) };
+                }
+                return [key, item];
+            }),
+        };
+    } finally {
+        seen.delete(value);
+    }
+}
+
+function errorName(error) {
+    if (error === null || typeof error !== "object") return dump(error);
+    return error.constructor ? error.constructor.name : "anonymous";
+}
+
+function matchers(actual, prefix) {
+    return new Proxy(
+        {},
+        {
+            get(_, name) {
+                if (name === "not" && prefix === "") return matchers(actual, "not.");
+                return (...args) => {
+                    const matcher = prefix + String(name);
+                    if (String(name) === "toThrow") {
+                        let outcome;
+                        try {
+                            actual();
+                            outcome = { returned: true };
+                        } catch (error) {
+                            outcome = { threw: errorName(error) };
+                        }
+                        log.push(["expect", matcher, outcome, args.map((arg) => dump(arg))]);
+                    } else {
+                        log.push(["expect", matcher, dump(actual), args.map((arg) => dump(arg))]);
+                    }
+                };
+            },
+        },
+    );
+}
+
+globalThis.expect = (actual) => matchers(actual, "");
+console.log = (...args) => log.push(["log", args.map((arg) => dump(arg))]);
+
+try {
+    const namespace = await import(pathToFileURL(process.argv[2]).href);
+    log.push(["exports", dump({ ...namespace })]);
+} catch (error) {
+    log.push(["uncaught", errorName(error)]);
+}
+process.stdout.write(JSON.stringify(log) + "\n");
